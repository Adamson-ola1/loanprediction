# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Data (raw data can be large / sensitive — keep out of git, document how to get it)
data/raw/*.csv
data/processed/*.csv
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Models & outputs (regenerated by the pipeline)
models/*.pkl
models/*.json
outputs/*.csv
outputs/*.json
outputs/plots/*.png
outputs/*.txt
charts/*.png
logs/

# Docker
docker/.env

# Airflow
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg
airflow/webserver_config.py
*.pid

# Jupyter
.ipynb_checkpoints/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/npm-debug.log*

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

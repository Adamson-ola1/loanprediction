# ==========================================================
# PYTHON
# ==========================================================

__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing / cache
.pytest_cache/
.coverage
htmlcov/
.coverage.*
coverage.xml


# ==========================================================
# ENVIRONMENT VARIABLES / SECRETS
# ==========================================================

.env
.env.*
!.env.example
!.env.production

# Frontend environment files
frontend/.env
frontend/.env.local
frontend/.env.*.local
# Keep environment template
!frontend/.env.example

# Docker environment
docker/.env


# ==========================================================
